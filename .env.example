# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Environment: "development" or "production"
APP_ENV=development

# Allowed CORS origin (production domain)
CORS_ORIGIN=http://localhost:5173

# --- Scaling -------------------------------------------------------------
# Shared state for multiple API instances/workers. Leave empty for a single
# in-memory instance.
REDIS_URL=
# Required with REDIS_URL: Fernet key that encrypts login sessions at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
# Pipelines running at once per instance (others queue with a live position)
MAX_CONCURRENT_PIPELINES=8
# >0 runs statistics in a process pool with this many workers
# (2 recommended in production: keeps the event loop responsive)
STATS_WORKERS=0
# Trust X-Forwarded-For for rate limiting (only behind your own proxy)
TRUST_PROXY=0

# --- Telegram API pacing (adaptive; these are starting points) -----------
TG_CONCURRENCY=4
TG_MAX_CONCURRENCY=10
# Pages of 100 of the user's messages read exactly before switching to
# stratified estimates (600 = 60k messages)
TG_PAGE_BUDGET=600
# Seconds of optional deep reading before results are finalised
TG_FETCH_DEADLINE=75
USE_TAKEOUT=1
# Seconds to wait if Telegram delays the takeout (export) session; 0 = never
TAKEOUT_MAX_WAIT=0

# --- Lifetimes ---------------------------------------------------------------
# Unused login sessions are revoked after this many seconds
SESSION_TTL=1800
# Finished results are kept this long
RESULT_TTL=21600
RATE_LIMIT_SEND_CODE=10
RATE_LIMIT_SEND_CODE_PHONE=3

# --- Bot notifications (optional) ---------------------------------------------
BOT_TOKEN=
FRONTEND_URL=
# Only one process may poll for bot updates; set RUN_BOT=0 on API replicas
# and run `python -m app.bot` once.
RUN_BOT=1
